{
  "name": "@momentumengineer/event-sourcing",
  "version": "0.0.2",
  "description": "Event sourcing building blocks: events, aggregates, command handlers and projections, with pluggable storage.",
  "author": "Momentum Engineer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momentumengineer/momentum-event-sourcing.git"
  },
  "keywords": [
    "event-sourcing",
    "cqrs",
    "projections",
    "kysely"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely/index.d.ts",
      "default": "./dist/kysely/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.postgres.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:publish": "npm run version:patch && npm publish --access public",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "peerDependencies": {
    "kysely": ">=0.28"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "kysely": "^0.28",
    "pg": "^8.23.1",
    "tsup": "^8",
    "typescript": "^6.0",
    "vitest": "^4.1.11"
  }
}
